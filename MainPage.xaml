<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:QR_generator.ViewModels"
             x:Class="QR_generator.MainPage"
             x:DataType="vm:MainViewModel"
             Title="QR Generator">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">

            <Label Text="Paste a link"
                   FontSize="20"
                   FontAttributes="Bold" />

            <Entry Text="{Binding Link}"
                   Placeholder="https://example.com"
                   Keyboard="Url"
                   ReturnType="Go"
                   ReturnCommand="{Binding GenerateCommand}" />

            <Label Text="{Binding ErrorMessage}"
                   TextColor="Red"
                   IsVisible="{Binding HasError}" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Grid.Column="0"
                        Text="Generate"
                        Command="{Binding GenerateCommand}" />
                <Button Grid.Column="1"
                        Text="Clear"
                        Command="{Binding ClearCommand}" />
            </Grid>

            <Image Source="{Binding QrImage}"
                   HeightRequest="280"
                   WidthRequest="280"
                   Aspect="AspectFit"
                   HorizontalOptions="Center" />

            <Button Text="Download QR"
                    Command="{Binding SaveCommand}" />

            <Label Text="{Binding StatusMessage}"
                   IsVisible="{Binding HasStatus}"
                   HorizontalTextAlignment="Center" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>